# Build stage: the toolchain never ships. The old image was golang:1.23.0 with
# the source and the whole Go toolchain still inside it, around 1 GB.
FROM golang:1.25-alpine AS build

WORKDIR /src

COPY backend/go.mod backend/go.sum ./
RUN go mod download

COPY backend/ ./
# Static binary so the runtime image needs no libc.
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/server ./cmd/server

# Runtime stage: alpine keeps a shell and wget for the health check, at ~8 MB.
FROM alpine:3.20

RUN adduser -D -u 10001 app
COPY --from=build /out/server /usr/local/bin/server
# Game content and balance (balance.json, spells.json, classes.json): plain
# JSON files, editable without a rebuild — but they still have to exist
# inside the image, since nothing else from the source tree is copied here.
# The server refuses to start if spells.json or classes.json is missing.
COPY backend/config/*.json /config/

USER app
EXPOSE 8080

ENV PORT=8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- "http://127.0.0.1:${PORT}/healthz" >/dev/null || exit 1

ENTRYPOINT ["/usr/local/bin/server"]
